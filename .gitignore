# Node
node_modules/
dist/
dist-ssr/
*.local

# Tauri build outputs
src-tauri/target/

# Environment files
.env
.env.local
.env.*.local

# Editor directories and files
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/

# pnpm
.pnpm-debug.log*

# Claude Code session artifacts (transient — agent worktrees, locks)
.claude/worktrees/
.claude/scheduled_tasks.lock

# Build script source data (Wahapedia CSVs + BSData XML — downloaded by developer, not committed)
scripts/data/
# Exception: aliases.json is manually curated and committed
!scripts/data/aliases.json
# Exception: translations_fr.json is a manually curated translation overlay
!scripts/data/translations_fr.json
# Exception: coverage-report.json is a build artifact tracked for diagnostics
!scripts/data/coverage-report.json

# User-local launcher overrides (optional - uncomment to ignore)
# launch-local.bat
# launch-dev-local.bat

# Local Tauri signing key (never commit)
/~/

# REL-06 local two-build verification artifacts (LOCAL-TEST-ONLY, never ship)
throwaway.key
throwaway.key.pub
# latest.json at repo root (generated by scripts/make-local-update.mjs — not the committed src-tauri/local-update.json template)
/latest.json
# NSIS installer artifacts generated during local update testing (already covered by src-tauri/target/ above,
# but explicit entries here guard against accidental staging of signed setup.exe / .sig files)
*-setup.exe
*.sig
